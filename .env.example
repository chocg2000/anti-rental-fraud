# 이 파일을 복사해서 .env로 저장하고 실제 값을 채워 넣을 것.
# .env 자체는 .gitignore로 제외되어 있음 — 여기(.env.example)엔 절대 실제 키를 넣지 말 것.

# 카카오 로컬 REST API (주소 -> 법정동코드/PNU/좌표) — address_resolver.py
# 발급: https://developers.kakao.com (애플리케이션 생성 -> REST API 키)
KAKAO_REST_API_KEY=

# 공공데이터포털 인증키 — real_transaction_price_adapter.py / building_register_adapter.py 공용
# 계정당 하나의 키를 아래 API 상품들에 각각 활용신청해서 사용:
#   국토교통부_아파트 매매 실거래자료, 국토교통부_연립다세대 매매 실거래자료,
#   국토교통부_오피스텔 매매 실거래자료, 건축HUB 건축물대장
# 발급: https://www.data.go.kr
MOLIT_SERVICE_KEY=

# 브이월드(VWorld) 공동주택가격속성조회 — public_price_adapter.py (README 참고)
# 발급: https://www.vworld.kr (키 발급 시 등록한 도메인이 아래 VWORLD_DOMAIN과 일치해야 함)
VWORLD_API_KEY=
VWORLD_DOMAIN=localhost

# Windows 로컬 개발 전용 — registry_summary_ocr.py가 호출하는 실행파일 전체 경로.
# Ubuntu/Debian 배포 서버(apt-get 설치)에서는 PATH에 잡히므로 비워두면 됨.
TESSERACT_CMD=
PDFTOPPM_CMD=
PDFINFO_CMD=

# 네이버 클로바 OCR(General, V2) — clova_ocr_adapter.py (README 참고, ⚠️ 미검증)
# 등기부 본문(갑구/을구) 페이지는 배경무늬 때문에 Tesseract 정확도가 낮아 상용 OCR로 대체.
# 발급: https://www.ncloud.com (콘솔 → AI·Application Service → CLOVA OCR → General 템플릿)
# CLOVA_OCR_INVOKE_URL은 계정마다 다른 고유 경로(콘솔에서 템플릿 생성 시 발급됨) — 절대
# 다른 프로젝트/예시의 URL을 그대로 쓰면 안 됨.
CLOVA_OCR_INVOKE_URL=
CLOVA_OCR_SECRET=

# B2C 무료 버전 비용 방어 스위치 — api.py의 POST /registry/upload가 클로바 OCR(갑구 소유권
# 이전 이력)을 호출할지 결정한다. B2C 배포에서는 반드시 false로 유지할 것: 위 키가 실수로
# 세팅돼 있어도 이 값이 false면 클로바 API가 절대 호출되지 않아 운영비용 0원이 보장된다.
# 나중에 B2B(전문가용) 버전을 띄울 때만 true로 전환한다.
USE_CLOVA_OCR=false
