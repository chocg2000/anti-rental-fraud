# 비밀키/환경변수 — 절대 커밋 금지
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
*.pyo

# 실제 개인정보가 담긴 테스트용 문서 (등기부등본 등)
*.pdf

# 포터블 tesseract/poppler 바이너리 (관리자 권한 없이 설치, .env로 경로만 참조)
tools/

# Node / frontend는 frontend/.gitignore에서 별도 관리

# Claude Code 세션 내부 상태 (프로젝트 소스 아님)
.claude/

# 실제 API 키가 포함된 임시 테스트 링크 파일
vworld_test_link.txt

# 배포용 SSH 개인키 — 절대 커밋 금지
*.pem

# SQLite 진단 결과 저장소 (assessment_store.py) — 로컬/컨테이너 런타임 데이터, 소스 아님
data/
*.db
